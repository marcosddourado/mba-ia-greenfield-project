FROM node:25.6.0-slim

# ffmpeg/ffprobe are needed by the video-worker (which builds from this same dev
# image) and by the processor's integration test (run inside the api container
# per nestjs-project/CLAUDE.md). The production worker uses Dockerfile.worker.
RUN apt update && apt install -y procps curl ffmpeg

WORKDIR /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ] 